# Birthday Pi faces worker: finds and groups faces in photos, in its own container with its own memory limit.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BIRTHDAY_PI_DATA=/data \
    BIRTHDAY_PI_MODELS=/models

WORKDIR /app
COPY requirements-faces.txt .
RUN pip install --no-cache-dir -r requirements-faces.txt

# OpenCV Zoo face models, pinned to one commit and checked: YuNet finds faces, SFace matches them.
ARG ZOO=https://media.githubusercontent.com/media/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models
ADD --checksum=sha256:8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4 \
    ${ZOO}/face_detection_yunet/face_detection_yunet_2023mar.onnx /models/yunet.onnx
ADD --checksum=sha256:0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79 \
    ${ZOO}/face_recognition_sface/face_recognition_sface_2021dec.onnx /models/sface.onnx
RUN chmod 0644 /models/*.onnx

COPY birthday_pi ./birthday_pi

# Same non-root user as the app, so both can write the shared data volume.
RUN useradd --uid 1000 --create-home app
USER app

CMD ["python", "-m", "birthday_pi.faces"]
